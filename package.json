{
  "name": "email-link-host",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "generate:well-known": "bun ./scripts/generate-well-known.ts",
    "version:sync": "bun ./scripts/sync-version.ts",
    "version:set": "bun ./scripts/sync-version.ts",
    "predev": "bun run generate:well-known",
    "dev": "next dev",
    "prebuild": "bun run generate:well-known",
    "build": "next build",
    "start": "next start",
    "serve": "go run ./cmd/server",
    "serve:bin": "VERSION=$(tr -d '[:space:]' < VERSION) && go build -ldflags=\"-s -w -X email-link-host/internal/version.Version=$VERSION\" -o bin/server ./cmd/server && ./bin/server",
    "docker:build": "VERSION=$(tr -d '[:space:]' < VERSION) && docker build --build-arg VERSION=$VERSION -t email-link-host:$VERSION -t email-link-host:latest .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env email-link-host:latest",
    "docs:dev": "bun --cwd docs-website start",
    "docs:build": "bun --cwd docs-website install && bun --cwd docs-website run build",
    "docs:serve": "bun --cwd docs-website serve",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
