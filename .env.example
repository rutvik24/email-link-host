# Optional path to a site JSON config (relative to project root or absolute).
# Defaults to embedded/config site.json when unset.
# Go/Docker also accepts NEXT_PUBLIC_SITE_CONFIG_PATH.
SITE_CONFIG_PATH=""

# Android / iOS store buttons (shown only when set).
# Go/Docker accepts either ANDROID_STORE_URL or NEXT_PUBLIC_ANDROID_STORE_URL (same for iOS).
NEXT_PUBLIC_ANDROID_STORE_URL=""
NEXT_PUBLIC_IOS_STORE_URL=""

# Optional content overrides (defaults live in the site JSON config).
# Go/Docker: SITE_BRAND or NEXT_PUBLIC_SITE_BRAND (and the other SITE_* keys).
NEXT_PUBLIC_SITE_BRAND=""
NEXT_PUBLIC_SITE_HEADLINE=""
NEXT_PUBLIC_SITE_TAGLINE=""
NEXT_PUBLIC_SITE_FOOTER=""
NEXT_PUBLIC_ANDROID_STORE_LABEL=""
NEXT_PUBLIC_IOS_STORE_LABEL=""

# Optional theme overrides (defaults live in the site JSON config).
# Go/Docker: THEME_ACCENT or NEXT_PUBLIC_THEME_ACCENT (and the other THEME_* keys).
NEXT_PUBLIC_THEME_BACKGROUND=""
NEXT_PUBLIC_THEME_BACKGROUND_ACCENT=""
NEXT_PUBLIC_THEME_FOREGROUND=""
NEXT_PUBLIC_THEME_MUTED=""
NEXT_PUBLIC_THEME_ACCENT=""
NEXT_PUBLIC_THEME_ACCENT_FOREGROUND=""
NEXT_PUBLIC_THEME_SURFACE=""
NEXT_PUBLIC_THEME_BORDER=""
NEXT_PUBLIC_THEME_GLOW=""

# Android App Links → /.well-known/assetlinks.json
# Go/Docker also accepts NEXT_PUBLIC_ANDROID_PACKAGE_NAME / NEXT_PUBLIC_ANDROID_SHA256_CERT_FINGERPRINTS.
ANDROID_PACKAGE_NAME=""
# Comma-separated SHA-256 fingerprints (Play App Signing and/or upload keystore)
ANDROID_SHA256_CERT_FINGERPRINTS=""

# iOS Universal Links → /.well-known/apple-app-site-association
# Go/Docker also accepts NEXT_PUBLIC_IOS_TEAM_ID / NEXT_PUBLIC_IOS_BUNDLE_ID / NEXT_PUBLIC_IOS_APP_PATHS.
IOS_TEAM_ID=""
IOS_BUNDLE_ID=""
# Optional comma-separated paths (default: NOT /_/*,/*)
IOS_APP_PATHS=""
